# GovFlow - example environment file.
#
# Copy to `.env` and fill in real values for your environment.
# `.env` is gitignored. NEVER commit a real .env.
#
# Every value below is intentionally left EMPTY. This file lists variable
# NAMES only. Generate real secrets locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Core ---
GOVFLOW_ENV=development

# Application signing secret. At least 32 bytes.
SECRET_KEY=

# Comma-separated allowed origins. Never "*" in production.
CORS_ORIGINS=http://localhost:3000

# --- Data stores ---
POSTGRES_USER=govflow
POSTGRES_PASSWORD=
POSTGRES_DB=govflow

# Format: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO in dev, S3 in AWS) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=govflow-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI provider ---
# LLM_PROVIDER: mock | openai-compatible
# When unset or "mock", the built-in mock adapter is used and no network call
# is made. When "openai-compatible", the key below is required.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Document pipeline ---
MAX_UPLOAD_MB=10
DOC_RETENTION_DAYS=90

# --- Simulator / demo defaults ---
# Daily capacity cap for the paid expedite lane, so it can never become a
# "pay to bypass everyone" lane.
SIM_TATKAL_DAILY_CAPACITY=5000

# Off-peak release window for deferred work (24h HH:MM).
DEFERRED_WINDOW_START=01:00
